# ============================================================================
#  Template — copy to `.env` and fill in your own values:  cp .env.example .env
# ============================================================================

NODE_ENV=development
PORT1=4000
PORT2=5000
API_BASE_URL=http://localhost:4000

# MongoDB (Atlas or local). Either variable can be used:
MONGODB_ATLAS=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
DB_NAME=lms_api
DB_NAME_TEST=lms_api_test
# Optional: run the test suite against a local mongod (much faster).
# Leave empty to use MONGODB_URI/MONGODB_ATLAS with DB_NAME_TEST instead.
MONGODB_URI_TEST=

# JWT
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_JWT=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
JWT_ISSUER=lms-api
JWT_AUDIENCE=lms-client
BCRYPT_SALT_ROUNDS=10

# HTTP / reverse proxy -------------------------------------------------------
# Allowed browser origins, comma separated. In development an empty value falls
# back to localhost:3000/5173/8080. In production this is required.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Number of proxy hops in front of the API (nginx/Render/Heroku = 1, direct = 0)
TRUST_PROXY=0
# true → redirect http:// to https:// (only when TLS terminates upstream)
FORCE_HTTPS=false
# ☁️ Render: NODE_ENV=production and PORT are provided by the platform. Use
#    TRUST_PROXY=1 and FORCE_HTTPS=false — Render's edge already redirects
#    HTTP → HTTPS before the request reaches the app. See render.yaml.

# Bind address (default 0.0.0.0 — required by Render and Docker). Local dev can
# leave this unset; set 127.0.0.1 to keep the API on this machine only.
# BIND_HOST=0.0.0.0

# Rate limiting (optional — values below are the defaults) --------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# Set to true to exercise the limiter while NODE_ENV=test
# RATE_LIMIT_ENABLED=false

# Swagger ---------------------------------------------------------------
# Always enabled outside production; opt-in inside production.
ENABLE_SWAGGER=false

# Demo seed (`npm run seed`) --------------------------------------------
# Empty → a strong random password is generated and printed once.
SEED_PASSWORD=
# Must be true to seed a non-local MongoDB (Atlas). Development only.
SEED_ALLOW_REMOTE=false
# Optional: seed a throwaway database instead of DB_NAME.
# SEED_DB_NAME=lms_demo

